<?xml version="1.0" encoding="utf-8"?>
<opml version="1.0">
    <head>
        <title>mindmap 2</title>
    </head>
    <body>
        <outline text="week 3">
            <outline text="">
                <outline text="DOM &amp; Events">
                    <outline text="innerHTML vs textContent（安全/性能差异）"/>
                    <outline text="事件流：捕获 → 目标 → 冒泡"/>
                    <outline text="e.target 与 e.currentTarget；事件委托"/>
                    <outline text="addEventListener/removeEventListener；stopPropagation/stopImmediatePropagation"/>
                    <outline text="不冒泡：focus/blur/load/mouseenter/mouseleave 等"/>
                    <outline text="自定义事件：new CustomEvent() + dispatchEvent()"/>
                </outline>
                <outline text="HTTP &amp; Tools">
                    <outline text="HTTP 状态码：200/201/204/307/400/401/403/404…"/>
                    <outline text="curl 常用：-o/-O、-L、-I、-H、-d/-F、-u、-x、-C 断点续传"/>
                    <outline text="python3 -m http.server 启动本地静态服务器（--directory / --bind）"/>
                </outline>
                <outline text="Cookies">
                    <outline text="用途：会话、个性化、跟踪；Set-Cookie/Cookie 头"/>
                    <outline text="生命周期：Session / Expires / Max-Age"/>
                    <outline text="安全：Secure / HttpOnly / SameSite(Strict|Lax|None) / Domain / Path"/>
                    <outline text="JS 访问：document.cookie（HttpOnly 不可见）"/>
                </outline>
                <outline text="JavaScript 类型与判型">
                    <outline text="原始：undefined/null/boolean/number/string/symbol/bigint"/>
                    <outline text="typeof / instanceof 差异；Object.prototype.toString.call 精准判型"/>
                    <outline text="显式/隐式转换；== 与 ===；NaN 特性"/>
                </outline>
                <outline text="数组与对象操作">
                    <outline text="不改原：slice/concat/filter/map/reduce/flat/flatMap/join/some/every"/>
                    <outline text="改原：push/pop/shift/unshift/splice/sort"/>
                    <outline text="Array.from/of/includes/at/entries"/>
                    <outline text="浅拷贝：Object.assign、展开运算符；深拷贝: Date/RegExp/Map/Set/循环引用"/>
                    <outline text="遍历类数组/NodeList：for/of（避免 for/in）"/>
                </outline>
                <outline text="原型与继承">
                    <outline text="对象 → 原型 → 原型链；constructor/__proto__/prototype"/>
                    <outline text="Object.create 定制原型；instanceof 沿原型链判断"/>
                </outline>
                <outline text="异步与事件循环">
                    <outline text="浏览器事件循环：宏任务/微任务/requestAnimationFrame"/>
                    <outline text="Promise：then/catch/finally；错误冒泡；Promise.all / race"/>
                    <outline text="Generator + runner 思想； 语法糖:async/await"/>
                    <outline text="并发 await：先创建 Promise，再 Promise.all"/>
                </outline>
                <outline text="定时器与动画">
                    <outline text="setTimeout/setInterval 的最小延时与主线程阻塞影响"/>
                    <outline text="高精度动画：requestAnimationFrame；performance.now 计时"/>
                </outline>
                <outline text="内存与 GC">
                    <outline text="可达性(标记清除)；循环引用可被回收"/>
                    <outline text="常见泄漏：意外全局、未清理定时器/监听、强缓存、DOM 引用遗留"/>
                    <outline text="WeakMap/WeakSet 存放临时映射避免阻止回收"/>
                </outline>
                <outline text="表单与 HTML">
                    <outline text="表单元素与 label for 关联；修正不规范 HTML"/>
                </outline>
                <outline text="CSS 与性能">
                    <outline text="首屏关键 CSS 内联，异步/延迟加载非关键 CSS（避免 @import）"/>
                    <outline text="减少昂贵选择器，雪碧图/小图 Base64"/>
                </outline>
            </outline>
        </outline>
    </body>
</opml>