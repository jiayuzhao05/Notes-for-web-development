<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>Front-end Mindmap (JS/TS/React) - from summary_251024.md</title>
  </head>
  <body>
    <outline text="JavaScript 基础">
      <outline text="回调函数">
        <outline text="定义：函数A作为参数传给函数B，完成后调用A" />
        <outline text="场景：定时器 / 网络请求 / 动画事件 / 点击事件" />
        <outline text="示例：greet(name, callback)" />
      </outline>
      <outline text="回调地狱">
        <outline text="多层异步依赖形成嵌套（Pyramid of Doom）" />
        <outline text="典型链：getUser → getOrders → getDetail" />
        <outline text="解决：Promise / async-await / 拆分函数" />
      </outline>
      <outline text="forEach 用法">
        <outline text="遍历每个元素（不可中断）" />
        <outline text="不返回新数组（返回 undefined）" />
        <outline text="可用 thisArg；原地修改需谨慎" />
        <outline text="异步注意：forEach 不会 await 回调" />
      </outline>
      <outline text="箭头函数 vs 普通函数">
        <outline text="不是语法糖：不绑定 this / arguments / super / new.target" />
        <outline text="this：普通函数动态绑定；箭头函数词法绑定" />
        <outline text="arguments：普通函数有；箭头函数无（用 ...args）" />
        <outline text="不可构造（不能 new）" />
      </outline>
      <outline text="DOM 树">
        <outline text="HTML → DOM；CSS → CSSOM → Render Tree → Layout/Paint/Composite" />
        <outline text="常用操作：querySelector / textContent / style / createElement / appendChild" />
        <outline text="父子、兄弟关系与节点类型（Element/Text/Comment）" />
      </outline>
    </outline>

    <outline text="TypeScript">
      <outline text="与 JS 的关系">
        <outline text="编译期类型检查，不能保证渲染一定成功" />
        <outline text="严格模式：strict / strictNullChecks / noImplicitAny" />
      </outline>
      <outline text="能提前发现的问题">
        <outline text="props/参数类型不匹配、JSX 属性错误" />
        <outline text="可空值使用、状态机穷尽检查" />
      </outline>
      <outline text="类型系统与语法">
        <outline text="原始类型：number/string/boolean/null/undefined/symbol" />
        <outline text="数组、元组、联合、字面量、接口、类型别名、枚举、void/any" />
        <outline text="可选参数/属性、类型断言（as / &lt;Type&gt;）" />
      </outline>
      <outline text="编译与运行">
        <outline text=".ts → tsc → .js → 运行于 Node/浏览器；ts-node 内部先编译再执行" />
      </outline>
    </outline>

    <outline text="React 基础">
      <outline text="核心与生态">
        <outline text="react（核心）、react-dom（DOM 扩展）、babel（JSX 转译）" />
      </outline>
      <outline text="JSX">
        <outline text="语法扩展：本质是 React.createElement 语法糖" />
        <outline text="列表渲染（key 唯一）、条件渲染、函数封装返回 JSX" />
      </outline>
      <outline text="组件基础">
        <outline text="函数组件 / 类组件；UI 可复用单元" />
        <outline text="props（只读） / state（内部可变） / refs（DOM 引用）" />
        <outline text="事件绑定：onClick/onChange，传参与事件对象" />
        <outline text="表单：受控（useState） vs 非受控（useRef）" />
      </outline>
    </outline>

    <outline text="React 进阶">
      <outline text="生命周期（类组件）">
        <outline text="Mount：constructor → render → componentDidMount" />
        <outline text="Update：shouldComponentUpdate → render → componentDidUpdate" />
        <outline text="Unmount：componentWillUnmount" />
      </outline>
      <outline text="Hooks">
        <outline text="useState / useEffect（副作用与清理） / useRef" />
        <outline text="自定义 Hook：封装与复用" />
      </outline>
      <outline text="组件通信">
        <outline text="父子：props / 回调" />
        <outline text="兄弟：状态提升到父" />
        <outline text="跨层：Context（Provider / useContext）" />
      </outline>
      <outline text="性能优化">
        <outline text="PureComponent / React.memo / shouldComponentUpdate（浅比较）" />
        <outline text="避免直接修改 state；生成新引用" />
      </outline>
      <outline text="错误边界">
        <outline text="getDerivedStateFromError / componentDidCatch 捕获后代错误" />
      </outline>
    </outline>

    <outline text="React Router">
      <outline text="基础">
        <outline text="BrowserRouter / HashRouter；路径匹配 → 组件渲染" />
        <outline text="Routes + Route；嵌套路由 + Outlet" />
      </outline>
      <outline text="导航与懒加载">
        <outline text="Link / NavLink（active/end）" />
        <outline text="useNavigate（编程式导航）" />
        <outline text="React.lazy + Suspense（代码分割）" />
      </outline>
    </outline>

    <outline text="状态管理（Redux）">
      <outline text="核心概念">
        <outline text="action（type/data）/ reducer（纯函数）/ store（createStore）" />
      </outline>
      <outline text="特性与函数范式">
        <outline text="纯函数（无副作用、不改参数）" />
        <outline text="高阶函数：map/filter/reduce/promise/connect 等" />
      </outline>
      <outline text="异步与集成">
        <outline text="中间件：redux-thunk / redux-saga（提及）" />
        <outline text="react-redux：Provider / connect" />
      </outline>
    </outline>

    <outline text="其他要点">
      <outline text="Fragment：无多余 DOM 包装" />
      <outline text="Render Props：以函数传 JSX 结构" />
      <outline text="PubSub 发布-订阅通信" />
      <outline text="Ajax：axios / fetch（GET/POST 基本用法）" />
      <outline text="Mock：json-server 模拟接口" />
      <outline text="SPA：单页应用结构" />
    </outline>
  </body>
</opml>
