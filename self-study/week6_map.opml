<?xml version="1.0" encoding="utf-8"?>
<opml version="1.0">
    <head>
        <title>week6_map</title>
    </head>
    <body>
        <outline text="week6">
            <outline text="JS">
                <outline text="JIT (Just-In-Time) 编译 / 性能要点"/>
                <outline text="函数是一等公民（可作为参数/返回值）"/>
                <outline text="Symbol">
                    <outline text="唯一性、不可枚举；避免命名冲突"/>
                    <outline text="Symbol.for / 全局注册表"/>
                    <outline text="Reflect.ownKeys / Object.getOwnPropertySymbols 获取符号键"/>
                    <outline text="作为对象私有属性"/>
                </outline>
                <outline text="对象属性遍历">
                    <outline text="for...in（键） / for...of（可迭代对象的值）"/>
                    <outline text="iteration：实现 [Symbol.iterator] 并返回 {next()}"/>
                </outline>
                <outline text="集合类型 &amp; 迭代器">
                    <outline text="Array：迭代器与 next() 的 value/done 协议"/>
                    <outline text="Set：元素唯一性（=== 比较）；并/交/差（filter + has）"/>
                    <outline text="Map: {key:value}；类型判断（instanceof / Object.prototype.toString）"/>
                </outline>
                <outline text="Array 高阶方法">
                    <outline text="filter 压缩稀疏数组 / 过滤 undefined、null"/>
                    <outline text="reduce / reduceRight：初始值与空数组边界"/>
                    <outline text="类数组转真数组：Array.from / slice.call(arguments)"/>
                </outline>
                <outline text="Number/Math/Object">
                    <outline text="Number.EPSILON / parseInt / parseFloat"/>
                    <outline text="Math.trunc / Math.sign"/>
                    <outline text="Object.is 与 NaN 比较；Object.assign 合并"/>
                    <outline text="Object.getOwnPropertyDescriptors / values / entries"/>
                </outline>
                <outline text="原型与继承（ES5）">
                    <outline text="构造函数借用 + 原型链；@constructor"/>
                </outline>
                <outline text="模块与构建">
                    <outline text="CommonJS：module.exports / exports / require"/>
                    <outline text="ES Modules：import；动态 import('./a.js').then(...)"/>
                    <outline text="Babel/Browserify：从新语法到旧语法、打包流程（npx 命令）"/>
                </outline>
            </outline>
            <outline text="异步编程">
                <outline text="Generator">
                    <outline text="yield 暂停/恢复；next(value) 作为上一个 yield 的返回值"/>
                    <outline text="串联异步：用户→订单→商品逐步驱动"/>
                </outline>
                <outline text="Promise basic">
                    <outline text="状态：pending → fulfilled/rejected，不可逆"/>
                    <outline text="then 返回值决定链式结果（非 Promise 值 / Promise）"/>
                    <outline text="封装：fs.readFile、XHR/Ajax 的 Promise 包装示例"/>
                </outline>
                <outline text="Promise 组合器">
                    <outline text="all / race / allSettled / any 的区别与使用场景"/>
                </outline>
                <outline text="async/await">
                    <outline text="顺序等待异步"/>
                    <outline text="错误处理与返回值（try/catch）"/>
                </outline>
            </outline>
            <outline text="Browser &amp; jQuery &amp; AJAX">
                <outline text="jQuery basic">
                    <outline text="就绪入口：$(fn) / $(document).ready(fn)"/>
                    <outline text="jQuery 对象与 DOM 对象互转（[0]/get/eq/first/last）"/>
                    <outline text="选择/筛选：parent/find/siblings/nextAll/closest/filter/not/has/is/hasClass"/>
                    <outline text="样式/类：css / addClass / removeClass / toggleClass"/>
                    <outline text="文本与属性：text/html/val/attr/prop"/>
                    <outline text="增删改：append/prepend/after/before/remove/empty/clone/detach"/>
                    <outline text="遍历：each / $.each"/>
                </outline>
                <outline text="jQuery animation">
                    <outline text="show/hide/toggle / fadeIn/out/Toggle/To / slideDown/Up / animate"/>
                    <outline text="队列控制：stop；hover 语义；触发 trigger/triggerHandler"/>
                </outline>
                <outline text="事件与委托">
                    <outline text="on/off 多事件绑定；委托到父元素；自动触发"/>
                </outline>
                <outline text="表单与序列化">
                    <outline text="serialize；FormData；提交事件拦截 e.preventDefault"/>
                </outline>
                <outline text="XHR/Ajax">
                    <outline text="原生 XHR：open/send/onreadystatechange；timeout/progress"/>
                    <outline text="文件上传：input+FormData，xhr.upload.onprogress 进度条"/>
                    <outline text="$.get/$.post/$.ajax 封装；Axios GET/POST 模式"/>
                </outline>
                <outline text="跨域与 JSONP">
                    <outline text="同源策略限制；利用 &lt;script src&gt; 绕过"/>
                    <outline text="jQuery JSONP：dataType='jsonp' / jsonp / jsonpCallback"/>
                </outline>
                <outline text="HTTP 基础速记">
                    <outline text="请求报文结构（行/头/空行/体）"/>
                    <outline text="状态码族：1xx/2xx/3xx/4xx/5xx，含 200/204/206"/>
                </outline>
                <outline text="性能优化案例">
                    <outline text="节流（mousemove 跟随示例）；防抖的对比概念"/>
                </outline>
            </outline>
            <outline text="Node.js &amp; Backend">
                <outline text="核心模块与路径">
                    <outline text="fs：readFile/writeFile/appendFile/unlink/rename/mkdir/rmdir/readdir/stat"/>
                    <outline text="path：basename/dirname/extname"/>
                </outline>
                <outline text="HTTP 服务器">
                    <outline text="基于 http 模块手写 Web 服务的思路"/>
                </outline>
                <outline text="模块系统">
                    <outline text="module 对象；exports 与 module.exports 的关系；加载优先级"/>
                </outline>
                <outline text="Express（提要）">
                    <outline text="路由与中间件；共享 req/res；局部中间件；前后端分离 API"/>
                </outline>
                <outline text="工具与部署">
                    <outline text="nodemon 热重启；JWT 鉴权（提要）"/>
                </outline>
            </outline>
            <outline text="Tooling: npm / Git / SSH">
                <outline text="npm">
                    <outline text="node_modules / package-lock.json 初次装包产物"/>
                    <outline text="devDependencies：npm i -D / --save-dev；registry 查看与切换"/>
                </outline>
                <outline text="Git">
                    <outline text="git config --global；git config --list --global"/>
                    <outline text="三区域：工作区/暂存区/仓库；三状态：modified/staged/committed"/>
                    <outline text="git rm -f（仓库+工作区）/ --cached（仅仓库）"/>
                    <outline text=".gitignore 规则速记（#、/、!、*、?、[]、{}）"/>
                </outline>
                <outline text="SSH"/>
            </outline>
        </outline>
    </body>
</opml>